#!/usr/bin/env bash
# The skill-creator runs' stand-in for the box's cx, for the claims playbook. It never touches the network.
#   cx raw amazon-sp-api --origin O --method M --path P [--header K=V]... [--query k=v]... [--body FILE|@FILE|B] [--output F] [--json]
# Reads are answered from $TENANT_TREE/../stub-replies/ first (beside the tree, out of the run's sight), then from the tree's
# landed replies under $TENANT_TREE/raw/amazon-sp-api/. Every change is refused (out_of_scope, exit 2): any PUT, PATCH or
# DELETE, and any POST that is not a report request. The application holds five roles (Product Listing, Pricing, Brand
# Analytics, Finance and Accounting, Amazon Fulfillment): a call that needs another (the Support API, the Data Kiosk Economics
# dataset, the seller performance report, AWD, ...) is answered 403 Unauthorized, as Amazon would. A report requested with
# POST /reports/2021-06-30/reports is DONE at once; its document's url is a file:// path under <dir>/report-files/ (beside the tree, readable by the run),
# tab-separated, gzipped where Amazon's reply would name GZIP. Each call is appended to $TENANT_TREE/../cx-calls.log: the
# command, the body it sent (when it sent one), and what it was answered ("-> HTTP 403 <file>" or "-> refused out_of_scope: ...").
# Works on bash 3.2 (macOS) and bash 5; JSON goes through python3 -I.
set -u
T="${TENANT_TREE:?TENANT_TREE is the seller tree}"
ROOT="$(cd "$T/.." && pwd)"
S="$ROOT/stub-replies"
echo "cx $*" >>"$ROOT/cx-calls.log"

refuse() {
  echo "  -> refused $1: $2" >>"$ROOT/cx-calls.log"
  python3 -I -c 'import json,sys; print(json.dumps({"request_id": "stub", "paths": [], "cost": [], "refusal": {"reason": sys.argv[1], "detail": sys.argv[2]}}))' "$1" "$2"
  exit 2
}
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

[ "${1-}" = raw ] || { echo "stub cx: this run has only 'cx raw amazon-sp-api ...'" >&2; exit 2; }
[ $# -ge 2 ] || { echo "stub cx: cx raw <source> --origin O --method M --path P ..." >&2; exit 2; }
src="$2"; shift 2
[ "$src" = amazon-sp-api ] || refuse out_of_scope "stub: this run has only amazon-sp-api"
method=GET path='' origin='' output='' json=0 body='' has_body=0 query=''
while [ $# -gt 0 ]; do
  case "$1" in
    --origin) origin="${2-}"; shift 2 ;;
    --method) method="$(printf '%s' "${2-}" | tr '[:lower:]' '[:upper:]')"; shift 2 ;;
    --path) path="${2-}"; shift 2 ;;
    --query) query="$query
${2-}"; shift 2 ;;
    --body) body="${2-}"; has_body=1; shift 2 ;;
    --output) output="${2-}"; shift 2 ;;
    --json) json=1; shift ;;
    --header)
      h="${2-}"; shift 2
      case "$h" in *=*) k="${h%%=*}" ;; *:*) k="${h%%:*}" ;; *) k="$h" ;; esac
      case "$(lower "$k")" in
        x-amz-access-token|authorization) refuse out_of_scope "the door attaches the seller's token; a request naming $k is refused" ;;
      esac ;;
    *) echo "stub cx: unknown flag $1" >&2; exit 2 ;;
  esac
done
[ -n "$path" ] || { echo "stub cx: --path is required" >&2; exit 2; }
case "$path" in /*) ;; *) path="/$path" ;; esac
path="$(printf '%s' "$path" | tr -s '/')"
case "$origin" in
  https://sellingpartnerapi-na.amazon.com|https://sellingpartnerapi-eu.amazon.com|https://sellingpartnerapi-fe.amazon.com) ;;
  https://sandbox.sellingpartnerapi-*) refuse out_of_scope "stub: this run has no sandbox replies" ;;
  '') refuse out_of_scope "amazon-sp-api needs --origin, one of the sellingpartnerapi hosts" ;;
  *) refuse out_of_scope "stub: $origin is not a Selling Partner API origin" ;;
esac
case "$(lower "${path#/}")" in tokens|tokens/*) refuse out_of_scope "the Tokens API is the door's own" ;; esac

case "$method" in
  GET|HEAD) [ $has_body -eq 0 ] || refuse out_of_scope "a $method with a body is not sent" ;;
  POST)
    case "$path" in
      /reports/2021-06-30/reports) ;;
      # reads sent as POST, answered below: the Support API's listCases (403, a role outside the five), Data Kiosk
      # (Economics 403), AWD (403), Product Fees estimates (no fixture in this run)
      /support/*|/dataKiosk/2023-11-15/queries|/awd/*|/products/fees/v0/*) ;;
      *) refuse out_of_scope "stub: this run sends no change to Amazon; POST $path is not a read this stand-in answers" ;;
    esac ;;
  PUT|PATCH|DELETE) refuse out_of_scope "stub: this run sends no change to Amazon ($method $path)" ;;
  *) refuse out_of_scope "$method is not sent" ;;
esac

STATE="$S/.state"
mkdir -p "$STATE"
bodyfile="$STATE/body-$$.json"
: >"$bodyfile"
if [ $has_body -eq 1 ]; then
  case "$body" in
    @*) f="${body#@}"; [ -f "$f" ] || refuse out_of_scope "no such body file: $f"; cat "$f" >"$bodyfile" ;;
    *) if [ -f "$body" ]; then cat "$body" >"$bodyfile"; else printf '%s' "$body" >"$bodyfile"; fi ;;
  esac
  printf '  body: %s\n' "$(tr -d '\n' <"$bodyfile" | cut -c1-2000)" >>"$ROOT/cx-calls.log"
fi
qfile="$STATE/query-$$.txt"
printf '%s\n' "$query" >"$qfile"

name="$(printf '%s' "${path%%\?*}" | tr '/' '-' | sed 's/^-//' | cut -c1-80)"
if [ -z "$output" ]; then
  mkdir -p "$T/raw/$src"
  output="$T/raw/$src/stub-$(date +%Y%m%dT%H%M%S)-$$-${RANDOM}-${name}.json"
fi
[ ! -e "$output" ] || { rm -f "$bodyfile" "$qfile"; refuse out_of_scope "the file is already there"; }
[ -d "$(dirname "$output")" ] || { rm -f "$bodyfile" "$qfile"; refuse out_of_scope "no such directory"; }

PY='
import datetime as dt, glob, gzip, hashlib, json, os, re, sys
from urllib.parse import unquote

method, path, origin, qfile, bodyfile, out, S, T = sys.argv[1:9]
STATE = os.path.join(S, ".state")
R = os.path.join(T, "raw", "amazon-sp-api")
SELLER = "A1FIXTURESELLER"
UTC = dt.timezone.utc
TODAY = dt.date(2026, 11, 17)
NOW = dt.datetime(2026, 11, 17, 16, 0, tzinfo=UTC)
REGION = {"https://sellingpartnerapi-na.amazon.com": "na", "https://sellingpartnerapi-eu.amazon.com": "eu",
          "https://sellingpartnerapi-fe.amazon.com": "fe"}[origin]
MKT_REGION = {"ATVPDKIKX0DER": "na", "A2EUQ1WTGCTBG2": "na", "A1AM78C64UM0Y8": "na", "A2Q3Y263D00KWC": "na",
              "A1PA6795UKMFR9": "eu", "A13V1IB3VIYZZH": "eu", "APJ6JRA9NG5V4": "eu", "A1RKKUPIHCS9HS": "eu",
              "A1805IZSGTT6HS": "eu", "A1F83G8C2ARO7P": "eu", "AMEN7PMS3EDWL": "eu", "A2NODRKZP88ZB9": "eu",
              "A1C3SOZRARQ6R3": "eu", "A2VIGQ35RCS4UG": "eu", "A17E79C6D8DWNP": "eu", "ARBP9OOSHTCHU": "eu",
              "A21TJRUUN4KGV": "eu", "A1VC38T7YXB528": "fe", "A39IBJ37TRP1C6": "fe", "A19VAU5U5O7RUS": "fe"}
STORE_OF = {"na": "ATVPDKIKX0DER", "eu": "A1F83G8C2ARO7P"}
SELLER_MKTS = set(STORE_OF.values())
raw = open(bodyfile).read()
Q = {}
for line in open(qfile).read().splitlines():
    if "=" in line:
        k, v = line.split("=", 1)
        Q.setdefault(k, []).append(unquote(v))
path_only, _, inline = path.partition("?")
for part in filter(None, inline.split("&")):
    k, _, v = part.partition("=")
    Q.setdefault(unquote(k), []).append(unquote(v))
path = path_only


def q(k, default=None):
    v = Q.get(k)
    return v[-1] if v else default


def qlist(k):
    out = []
    for v in Q.get(k, []):
        out += [x for x in v.split(",") if x]
    return out


def reply(status, doc):
    with open(out, "w") as f:
        if isinstance(doc, str):
            f.write(doc)
        else:
            json.dump(doc, f, indent=2, ensure_ascii=False)
    print(status)
    sys.exit(0)


def err(status, code, message, details=""):
    reply(status, {"errors": [{"code": code, "message": message, "details": details}]})


def unauthorized():
    err(403, "Unauthorized", "Access to requested resource is denied.", "")


def latest(name):
    for base in (S, R):
        hits = sorted(glob.glob(os.path.join(base, name)))
        if hits:
            return json.load(open(hits[-1]))
    return None


def body():
    if not raw.strip():
        return {}
    try:
        return json.loads(raw)
    except ValueError:
        err(400, "InvalidInput", "The request body is not valid JSON.")


def mkt_ok(m):
    if m not in MKT_REGION:
        err(400, "InvalidInput", "Invalid Marketplace ID: %s" % m)
    if MKT_REGION[m] != REGION:
        err(400, "InvalidInput", "Marketplace %s is not served by this endpoint." % m)
    if m not in SELLER_MKTS:
        unauthorized()


def ts(s, name):
    try:
        s = s.strip()
        if len(s) == 10:
            s += "T00:00:00Z"
        t = dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
        return t if t.tzinfo else t.replace(tzinfo=UTC)
    except (ValueError, AttributeError):
        err(400, "InvalidInput", "%s is not an ISO 8601 date-time: %r" % (name, s))


if REGION == "fe":
    err(403, "Unauthorized", "Access to requested resource is denied.", "The seller has no store in this region.")

# roles outside the five: answered as Amazon answers a role the application lacks
if re.match(r"/(support|awd|supplySources|externalFulfillment|easyShip|vendor|shipping/v2|mfn|messaging|solicitations|finances/transfers/wallet)(/|$)", path):
    unauthorized()
if path == "/dataKiosk/2023-11-15/queries" and method == "POST":
    if "economics" in raw.lower():
        unauthorized()
    err(400, "InvalidInput", "stub: this run answers no Data Kiosk query")
if path.startswith("/dataKiosk/"):
    err(404, "NotFound", "stub: no Data Kiosk query in this run")
if path.startswith("/products/fees/"):
    err(404, "NotFound", "stub: this run holds no fee-estimate fixture; the Fee Preview report carries the fees on file")

# ---- FBA inventory
if path == "/fba/inventory/v1/summaries":
    if q("granularityType") != "Marketplace" or not q("granularityId") or not q("marketplaceIds"):
        err(400, "InvalidInput", "granularityType (Marketplace), granularityId and marketplaceIds are required.")
    m = q("marketplaceIds")
    mkt_ok(m)
    if q("granularityId") != m:
        err(400, "InvalidInput", "granularityId must be the marketplace in marketplaceIds.")
    doc = latest("getInventorySummaries-%s.json" % m)
    skus = qlist("sellerSkus") or ([q("sellerSku")] if q("sellerSku") else [])
    if len(skus) > 50:
        err(400, "InvalidInput", "sellerSkus takes at most 50 SKUs.")
    rows = doc["payload"]["inventorySummaries"]
    if skus:
        rows = [r for r in rows if r["sellerSku"] in skus]
    if (q("details") or "false").lower() != "true":
        rows = [{k: v for k, v in r.items() if k != "inventoryDetails"} for r in rows]
    doc["payload"]["inventorySummaries"] = rows
    reply(200, doc)

# ---- Sellers
if path == "/sellers/v1/marketplaceParticipations":
    reply(200, latest("getMarketplaceParticipations-%s.json" % REGION) or {"payload": []})

# ---- Reports
UNAUTH_TYPES = ("GET_V2_SELLER_PERFORMANCE_REPORT", "GET_FLAT_FILE_RETURNS_DATA_BY_RETURN_DATE", "GET_AMAZON_FULFILLED_SHIPMENTS_DATA_INVOICING")
REMOVED = ("GET_FBA_FULFILLMENT_INVENTORY_ADJUSTMENTS_DATA", "GET_FBA_FULFILLMENT_INVENTORY_RECEIPTS_DATA", "GET_FBA_RECONCILIATION_REPORT_DATA",
           "GET_FBA_FULFILLMENT_INVENTORY_SUMMARY_DATA", "GET_FBA_FULFILLMENT_MONTHLY_INVENTORY_DATA", "GET_FBA_FULFILLMENT_CURRENT_INVENTORY_DATA",
           "GET_FBA_INVENTORY_AGED_DATA", "GET_DATE_RANGE_FINANCIAL_TRANSACTION_DATA", "GET_V2_SETTLEMENT_REPORT_DATA_FLAT_FILE",
           "GET_V2_SETTLEMENT_REPORT_DATA_XML")
LEDGER_REACH = dt.date(2025, 5, 17)

if path == "/reports/2021-06-30/reports" and method == "POST":
    b = body()
    rtype, mkts = b.get("reportType"), b.get("marketplaceIds") or []
    if not rtype or not mkts:
        err(400, "InvalidInput", "reportType and marketplaceIds are required.")
    for m in mkts:
        mkt_ok(m)
    if rtype in UNAUTH_TYPES:
        unauthorized()
    if rtype in REMOVED:
        err(400, "InvalidInput", "Report type %s is not supported." % rtype)
    if rtype.startswith("GET_V2_SETTLEMENT"):
        err(400, "InvalidInput", "Settlement reports cannot be requested; Amazon schedules them.")
    if rtype == "GET_FBA_FULFILLMENT_CUSTOMER_SHIPMENT_REPLACEMENT_DATA" and REGION != "na":
        err(400, "InvalidInput", "Report type %s is not available in this marketplace." % rtype)
    opts = b.get("reportOptions") or {}
    if "eventType" in opts and not opts.get("eventType"):
        err(400, "InvalidInput", "1 validation error detected: Value at \x27reportOptions.eventType\x27 failed to satisfy constraint: Member must have length greater than or equal to 1")
    os.makedirs(os.path.join(STATE, "reports"), exist_ok=True)
    os.makedirs(os.path.join(os.path.dirname(S), "report-files"), exist_ok=True)
    n = len(os.listdir(os.path.join(STATE, "reports"))) + 1
    rid = str(54000000000 + n * 7919)
    stamp = "2026-11-17T15:%02d:%02d+00:00" % ((5 + n) % 60, (13 * n) % 60)
    m = mkts[0]
    srcf = os.path.join(S, "report-sources", "%s-%s.json" % (rtype, m))
    rep = {"reportType": rtype, "processingEndTime": stamp, "processingStatus": "DONE", "marketplaceIds": mkts, "reportId": rid,
           "dataStartTime": b.get("dataStartTime") or stamp, "dataEndTime": b.get("dataEndTime") or stamp, "createdTime": stamp,
           "processingStartTime": stamp}
    if not os.path.exists(srcf):
        rep["processingStatus"] = "CANCELLED"
        rep.pop("processingEndTime")
    else:
        src = json.load(open(srcf))
        rows, head = src["rows"], src["header"]
        start = (b.get("dataStartTime") or "")[:10]
        end = (b.get("dataEndTime") or "")[:10]
        if start:
            ts(b["dataStartTime"], "dataStartTime")
        if end:
            ts(b["dataEndTime"], "dataEndTime")
        dc = src["date"]
        if src["kind"] in ("range", "ledger-summary", "ledger-detail") and dc:
            w = 7 if dc == "month_of_charge" else 10
            if start:
                rows = [r for r in rows if str(r[dc])[:w] >= start[:w]]
            if end:
                rows = [r for r in rows if str(r[dc])[:w] <= end[:w]]
        if src["kind"] in ("ledger-detail", "ledger-summary"):
            rows = [r for r in rows if r["Date"] >= LEDGER_REACH.isoformat()]
            for k in ("FNSKU", "MSKU", "ASIN"):
                if opts.get(k):
                    rows = [r for r in rows if r[k] == opts[k]]
        if src["kind"] == "ledger-detail":
            if not start:
                err(400, "InvalidInput", "dataStartTime is required for this report type.")
            ev = opts.get("eventType")
            if ev:
                rows = [r for r in rows if r["Event Type"] == ev]
            rows = [dict(r, Date=dt.date.fromisoformat(r["Date"]).strftime("%m/%d/%Y")) for r in rows]
        if src["kind"] == "ledger-summary":
            if not start or not end:
                err(400, "InvalidInput", "dataStartTime and dataEndTime are required for this report type.")
            period = (opts.get("aggregatedByTimePeriod") or "MONTHLY").upper()
            s0, e0 = dt.date.fromisoformat(start), dt.date.fromisoformat(end)
            nextd = e0 + dt.timedelta(1)
            valid = {"DAILY": True, "WEEKLY": s0.weekday() == 0 and e0.weekday() == 6,
                     "MONTHLY": s0.day == 1 and nextd.day == 1}.get(period, False)
            if not valid:
                rows = []
            elif period != "DAILY":
                def bucket(d):
                    d = dt.date.fromisoformat(d)
                    return d.strftime("%m/%Y") if period == "MONTHLY" else (d - dt.timedelta(d.weekday())).strftime("%m/%d/%Y")
                agg, order = {}, []
                for r in rows:
                    key = (bucket(r["Date"]), r["MSKU"], r["Disposition"])
                    if key not in agg:
                        agg[key] = dict(r, Date=key[0])
                        order.append(key)
                        continue
                    a = agg[key]
                    for c in ("Receipts", "Customer Shipments", "Customer Returns", "Vendor Returns", "Warehouse Transfer In/Out", "Found",
                              "Lost", "Damaged", "Disposed", "Other Events", "Unknown Events"):
                        a[c] += r[c]
                    a["Ending Warehouse Balance"], a["In Transit Between Warehouses"] = r["Ending Warehouse Balance"], r["In Transit Between Warehouses"]
                rows = [agg[k] for k in order]
            else:
                rows = [dict(r, Date=dt.date.fromisoformat(r["Date"]).strftime("%m/%d/%Y")) for r in rows]
        text = "\t".join(head) + "\n" + "".join("\t".join("" if r.get(c) is None else str(r.get(c)) for c in head) + "\n" for r in rows)
        did = "amzn1.spdoc.1.4.%s.%s" % (REGION, hashlib.sha256((rid + rtype).encode()).hexdigest()[:8] + "-" +
                                          hashlib.sha256(rid.encode()).hexdigest()[:4] + "-4c1b-9b59-" + hashlib.sha256(raw.encode()).hexdigest()[:12])
        fn = os.path.join(os.path.dirname(S), "report-files", did + (".txt.gz" if src["gzip"] else ".txt"))
        data = (b"\xef\xbb\xbf" if src.get("bom") else b"") + text.encode("utf-8")
        if src["gzip"]:
            with gzip.open(fn, "wb") as f:
                f.write(data)
        else:
            open(fn, "wb").write(data)
        rep["reportDocumentId"] = did
        doc = {"reportDocumentId": did, "url": "file://" + os.path.abspath(fn)}
        if src["gzip"]:
            doc["compressionAlgorithm"] = "GZIP"
        json.dump(doc, open(os.path.join(STATE, "doc-" + did + ".json"), "w"))
    json.dump(rep, open(os.path.join(STATE, "reports", rid + ".json"), "w"))
    reply(202, {"reportId": rid})

m = re.fullmatch(r"/reports/2021-06-30/reports/([^/]+)", path)
if m and method in ("GET", "HEAD"):
    f = os.path.join(STATE, "reports", m.group(1) + ".json")
    if not os.path.exists(f):
        err(404, "NotFound", "Report not found: %s" % m.group(1))
    reply(200, json.load(open(f)))

m = re.fullmatch(r"/reports/2021-06-30/documents/([^/]+)", path)
if m:
    f = os.path.join(STATE, "doc-" + m.group(1) + ".json")
    if not os.path.exists(f):
        err(404, "NotFound", "Report document not found: %s" % m.group(1))
    reply(200, json.load(open(f)))

if path == "/reports/2021-06-30/reports":
    types, nt = qlist("reportTypes"), q("nextToken")
    if not types and not nt:
        err(400, "InvalidInput", "reportTypes or nextToken is required.")
    d = os.path.join(STATE, "reports")
    reps = [json.load(open(os.path.join(d, x))) for x in sorted(os.listdir(d))] if os.path.isdir(d) else []
    reps = [r for r in reps if r["reportType"] in types]
    st = qlist("processingStatuses")
    if st:
        reps = [r for r in reps if r["processingStatus"] in st]
    reply(200, {"reports": list(reversed(reps))})

if path.startswith("/reports/2021-06-30/schedules"):
    reply(200, {"reportSchedules": []})

# ---- Fulfillment Inbound v0 reads
if path == "/fba/inbound/v0/shipments":
    mk = q("MarketplaceId")
    if not mk or not q("QueryType"):
        err(400, "InvalidInput", "MarketplaceId and QueryType are required.")
    mkt_ok(mk)
    doc = latest("getShipments-%s.json" % mk) or {"payload": {"ShipmentData": []}}
    rows = doc["payload"]["ShipmentData"]
    qt = q("QueryType")
    if qt == "SHIPMENT":
        st, ids = qlist("ShipmentStatusList"), qlist("ShipmentIdList")
        if not st and not ids:
            err(400, "InvalidInput", "ShipmentStatusList or ShipmentIdList is required for QueryType SHIPMENT.")
        rows = [r for r in rows if (not st or r["ShipmentStatus"] in st) and (not ids or r["ShipmentId"] in ids)]
    elif qt == "DATE_RANGE":
        if not q("LastUpdatedAfter") or not q("LastUpdatedBefore"):
            err(400, "InvalidInput", "LastUpdatedAfter and LastUpdatedBefore are required for QueryType DATE_RANGE.")
    elif qt != "NEXT_TOKEN":
        err(400, "InvalidInput", "QueryType is SHIPMENT, DATE_RANGE or NEXT_TOKEN.")
    reply(200, {"payload": {"ShipmentData": rows}})

m = re.fullmatch(r"/fba/inbound/v0/shipments/([^/]+)/items", path)
if m:
    if q("MarketplaceId"):  # optional on this operation in the model
        mkt_ok(q("MarketplaceId"))
    doc = latest("getShipmentItemsByShipmentId-%s.json" % m.group(1))
    if doc is None:
        err(400, "InvalidInput", "Shipment %s not found." % m.group(1))
    reply(200, doc)

if path == "/fba/inbound/v0/shipmentItems":
    if not q("MarketplaceId") or not q("QueryType"):
        err(400, "InvalidInput", "MarketplaceId and QueryType are required.")
    mkt_ok(q("MarketplaceId"))
    items = []
    for f in sorted(glob.glob(os.path.join(S, "getShipmentItemsByShipmentId-*.json"))):
        items += json.load(open(f))["payload"]["ItemData"]
    reply(200, {"payload": {"ItemData": items}})

if path.startswith("/inbound/fba/2024-03-20/"):
    err(404, "NotFound", "stub: this run holds no 2024-03-20 inbound plans; the shipments are read through v0")

# ---- Finances 2024-06-19
if path == "/finances/2024-06-19/transactions":
    store = STORE_OF[REGION]
    if q("marketplaceId"):
        mkt_ok(q("marketplaceId"))
        store = q("marketplaceId")
    rin, riv = q("relatedIdentifierName"), q("relatedIdentifierValue")
    if rin and rin not in ("FINANCIAL_EVENT_GROUP_ID", "ORDER_ID"):
        err(400, "InvalidInput", "relatedIdentifierName %s is not supported; FINANCIAL_EVENT_GROUP_ID and ORDER_ID are the only values" % rin)
    if rin and not riv:
        err(400, "InvalidInput", "relatedIdentifierValue is required with relatedIdentifierName")
    if not rin and not q("postedAfter"):
        err(400, "InvalidInput", "postedAfter is required if you do not specify a related identifier")
    edge = NOW - dt.timedelta(minutes=2)
    after = ts(q("postedAfter"), "postedAfter") if q("postedAfter") else None
    before = ts(q("postedBefore"), "postedBefore") if q("postedBefore") else edge
    if after and after > edge:
        err(400, "InvalidInput", "postedAfter must be more than two minutes before the time of the request")
    if before > edge:
        err(400, "InvalidInput", "postedBefore must be more than two minutes before the time of the request")
    if after and before <= after:
        err(400, "InvalidInput", "postedBefore must be later than postedAfter")
    hits = []
    if not (after and (before - after) > dt.timedelta(days=180)):
        for x in latest("transactions.json")["transactions"]:
            if x["marketplaceDetails"]["marketplaceId"] != store:
                continue
            p = ts(x["postedDate"], "postedDate")
            if rin and not any(r["relatedIdentifierName"] == rin and r["relatedIdentifierValue"] == riv for r in x["relatedIdentifiers"]):
                continue
            if after and not after <= p < before:
                continue
            if not after and p >= before:
                continue
            st = q("transactionStatus")
            if st and x["transactionStatus"] != st:
                continue
            hits.append(x)
    start = int((q("nextToken") or "stub-0").split("-")[-1] or 0)
    page = hits[start:start + 100]
    pl = {"transactions": page}
    if start + 100 < len(hits):
        pl["nextToken"] = "stub-%d" % (start + 100)
    reply(200, {"payload": pl})

if path.startswith("/finances/v0/"):
    err(404, "NotFound", "stub: this run answers money lines through /finances/2024-06-19/transactions; v0 events are not in it")
if path.startswith("/finances/2024-06-19/"):
    err(404, "NotFound", "stub: this run answers listTransactions only")

# ---- Orders 2026-01-01
ORD = {o["orderId"]: o for o in latest("orders.json")["orders"]}


def shape(o):
    inc = set(qlist("includedData"))
    return {k: v for k, v in o.items() if k not in ("fulfillment",) or "FULFILLMENT" in inc}


m = re.fullmatch(r"/orders/2026-01-01/orders/([0-9-]+)", path)
if m:
    o = ORD.get(m.group(1))
    if not o or MKT_REGION[o["salesChannel"]["marketplaceId"]] != REGION:
        err(404, "NotFound", "Order %s was not found." % m.group(1))
    reply(200, {"order": shape(o)})

if path == "/orders/2026-01-01/orders":
    mks = qlist("marketplaceIds")
    if not mks:
        err(400, "InvalidInput", "marketplaceIds is required")
    for x in mks:
        mkt_ok(x)
    if not q("createdAfter") and not q("lastUpdatedAfter") and not q("paginationToken"):
        err(400, "InvalidInput", "createdAfter or lastUpdatedAfter is required")
    key = "createdTime" if q("createdAfter") or not q("lastUpdatedAfter") else "lastUpdatedTime"
    a = ts(q("createdAfter") or q("lastUpdatedAfter") or "2000-01-01", "createdAfter")
    e = ts(q("createdBefore") or q("lastUpdatedBefore"), "createdBefore") if (q("createdBefore") or q("lastUpdatedBefore")) else NOW - dt.timedelta(minutes=2)
    hits = [o for o in ORD.values() if o["salesChannel"]["marketplaceId"] in mks and a <= ts(o[key], key) < e]
    hits.sort(key=lambda o: o[key])
    size = max(1, min(100, int(q("maxResultsPerPage") or 100)))
    start = int((q("paginationToken") or "stub-0").split("-")[-1] or 0)
    doc = {"orders": [shape(o) for o in hits[start:start + size]], "createdBefore": e.strftime("%Y-%m-%dT%H:%M:%SZ")}
    if start + size < len(hits):
        doc["pagination"] = {"nextToken": "stub-%d" % (start + size)}
    reply(200, doc)

if path.startswith("/orders/v0/"):
    err(404, "NotFound", "stub: this run answers orders through /orders/2026-01-01")

# ---- Catalog Items 2022-04-01
m = re.fullmatch(r"/catalog/2022-04-01/items/([A-Z0-9]+)", path)
if m:
    mks = qlist("marketplaceIds")
    if not mks:
        err(400, "InvalidInput", "marketplaceIds is required")
    for x in mks:
        mkt_ok(x)
    doc = latest("getCatalogItem-%s-%s.json" % (m.group(1), mks[0]))
    if doc is None:
        err(404, "NotFound", "Requested item \x27%s\x27 not found in marketplace %s" % (m.group(1), mks[0]))
    inc = qlist("includedData") or ["summaries"]
    reply(200, {k: v for k, v in doc.items() if k == "asin" or k in inc})
if path == "/catalog/2022-04-01/items":
    err(404, "NotFound", "stub: searchCatalogItems has no fixture in this run; getCatalogItem by ASIN has")

err(404, "NotFound", "stub: no fixture for this path")
'
status="$(python3 -I -c "$PY" "$method" "$path" "$origin" "$qfile" "$bodyfile" "$output" "$S" "$T")"
rc=$?
rm -f "$bodyfile" "$qfile"
[ $rc -eq 0 ] && [ -n "$status" ] || { echo "  -> internal error" >>"$ROOT/cx-calls.log"; echo "stub cx: internal error" >&2; exit 1; }
echo "  -> HTTP $status $output" >>"$ROOT/cx-calls.log"
case "$status" in 2??) kind=fresh code=0 ;; *) kind=failed code=1 ;; esac
if [ $json -eq 1 ]; then
  printf '{"request_id":"stub","paths":[{"path":"%s","http_status":%s,"outcome":{"kind":"%s"},"file":"%s"}],"cost":[]}\n' "${path%%\?*}" "$status" "$kind" "$output"
else
  [ $code -eq 0 ] || echo "the source answered HTTP $status" >&2
  echo "$output"
fi
exit $code
